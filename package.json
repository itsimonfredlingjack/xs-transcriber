{
  "name": "discord-transcriber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "deploy": "npm run build && node --env-file=.env dist/bot/src/deploy-commands.js",
    "start": "node --env-file=.env dist/bot/src/index.js",
    "dev": "tsx --env-file=.env bot/src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey-linux-x64-gnu": "0.1.12",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "node-crc": "file:vendor/node-crc",
    "opusscript": "^0.0.8",
    "prism-media": "^2.0.0-alpha.0"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "0.28.1",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
