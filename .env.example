# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set for fast, guild-scoped command registration. Leave empty for global commands.
DISCORD_GUILD_ID=

# Local worker connection. Keep the worker bound to loopback.
WORKER_URL=http://127.0.0.1:8765
WORKER_API_TOKEN=replace-with-a-long-random-value
WORKER_HOST=127.0.0.1
WORKER_PORT=8765

# Shared runtime storage
RECORDINGS_ROOT=/home/simon/discord-transcriber/recordings
WHISPER_CACHE_DIR=/home/simon/whisper/models
WHISPER_LIVE_MODEL=KBLab/kb-whisper-small
WHISPER_FINAL_MODEL=KBLab/kb-whisper-large
WHISPER_FINAL_REVISION=main
WHISPER_LANGUAGE=sv
CUDA_DEVICE=0

# Voice reliability tuning
SPEECH_END_SILENCE_MS=1000
AUDIO_WATCHDOG_SECONDS=60
WORKER_POLL_MS=2000
VOICE_DEBUG=false
WHISPER_COMPUTE_TYPE=int8_float16
